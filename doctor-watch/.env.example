# ── 필수 ─────────────────────────────────────────────
# 심평원 병원정보서비스 (공공데이터포털에서 무료 발급: https://www.data.go.kr/data/15001698/openapi.do)
HIRA_SERVICE_KEY=
# Claude API 키 (의료진 페이지 → 이름/진료과/직위 구조화 추출)
ANTHROPIC_API_KEY=

# ── 선택 ─────────────────────────────────────────────
# 추출 모델. 기본 claude-opus-5. 비용을 낮추려면 claude-haiku-4-5 (정확도 소폭 하락)
DOCTOR_WATCH_MODEL=claude-opus-5
# SQLite 경로
DOCTOR_WATCH_DB=data/doctor_watch.db
# 동시 접속 수 / 병원당 최대 수집 페이지 수 / 페이지당 최대 문자 수
DOCTOR_WATCH_CONCURRENCY=8
DOCTOR_WATCH_MAX_PAGES=40
DOCTOR_WATCH_MAX_CHARS=120000
# JS 렌더링(playwright) 사용 여부: auto | always | never
DOCTOR_WATCH_RENDER=auto

# ── 브리핑 발송 (설정된 채널만 발송) ─────────────────
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
